    <effect id="Effect_CmnPole1">
      <profile_COMMON>
        <newparam sid="surface_CmnPole1-diffuse">
          <surface type="2D">
            <init_from>CmnPole1_Alb</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="sampler_CmnPole1-diffuse">
          <sampler2D>
            <source>surface_CmnPole1-diffuse</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
          </sampler2D>
        </newparam>
        <newparam sid="surface_CmnPole1-bump">
          <surface type="2D">
            <init_from>CmnPole1_Nrm</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="sampler_CmnPole1-bump">
          <sampler2D>
            <source>surface_CmnPole1-bump</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
          </sampler2D>
        </newparam>
        <newparam sid="surface_CmnPole1-specular">
          <surface type="2D">
            <init_from>CmnPole1_Spm</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="sampler_CmnPole1-specular">
          <sampler2D>
            <source>surface_CmnPole1-specular</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <phong>
            <diffuse>
              <texture texture="sampler_CmnPole1-diffuse" texcoord="CHANNEL0" />
            </diffuse>
            <bump>
              <texture texture="sampler_CmnPole1-bump" texcoord="CHANNEL0" />
            </bump>
            <specular>
              <texture texture="sampler_CmnPole1-specular" texcoord="CHANNEL0" />
            </specular>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
