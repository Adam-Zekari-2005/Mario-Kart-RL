  <library_effects>
    <effect id="Effect_RR64_CubeMap_00">
      <profile_COMMON>
        <newparam sid="surface_RR64_CubeMap_00-diffuse">
          <surface type="2D">
            <init_from>RR64_CubeMap_Alb</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="sampler_RR64_CubeMap_00-diffuse">
          <sampler2D>
            <source>surface_RR64_CubeMap_00-diffuse</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <phong>
            <diffuse>
              <texture texture="sampler_RR64_CubeMap_00-diffuse" texcoord="CHANNEL0" />
            </diffuse>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <specular>
              <color sid="specular">0 0 0 1</color>
            </specular>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="Effect_RR64_CubeMap_01">
