  <library_effects>
    <effect id="Effect_CmnStartGrid2">
      <profile_COMMON>
        <newparam sid="surface_CmnStartGrid2-diffuse">
          <surface type="2D">
            <init_from>Gwp_StartGrid00_Alb</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="sampler_CmnStartGrid2-diffuse">
          <sampler2D>
            <source>surface_CmnStartGrid2-diffuse</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
          </sampler2D>
        </newparam>
        <newparam sid="surface_CmnStartGrid2-bump">
          <surface type="2D">
            <init_from>Gwp_StartGrid00_Nrm</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="sampler_CmnStartGrid2-bump">
          <sampler2D>
            <source>surface_CmnStartGrid2-bump</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
          </sampler2D>
        </newparam>
        <newparam sid="surface_CmnStartGrid2-specular">
          <surface type="2D">
            <init_from>Gwp_StartGrid00_Spm</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="sampler_CmnStartGrid2-specular">
          <sampler2D>
            <source>surface_CmnStartGrid2-specular</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <phong>
            <diffuse>
              <texture texture="sampler_CmnStartGrid2-diffuse" texcoord="CHANNEL0" />
            </diffuse>
            <bump>
              <texture texture="sampler_CmnStartGrid2-bump" texcoord="CHANNEL0" />
            </bump>
            <specular>
              <texture texture="sampler_CmnStartGrid2-specular" texcoord="CHANNEL0" />
            </specular>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
